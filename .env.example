# Local / Vercel environment

# Required for the /contact consult form and /print quote form.
# Vercel project → Settings → Environment Variables → RESEND_API_KEY
RESEND_API_KEY=

# Optional. Defaults to: TBC Advisory <notify@tbcadvisory.com>
# Must be a domain/sender verified in Resend. Reply-To is the visitor.
RESEND_FROM=

# Optional. Hidden /assess gate. Unrelated to the public consult form.
# ASSESS_ACCESS_KEY=
# ASSESS_NOTIFY_EMAIL=info@tbcadvisory.com

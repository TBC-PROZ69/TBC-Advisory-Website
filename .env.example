# Local / Vercel environment

# Required for the /contact consult form and /print quote form.
# Vercel project → Settings → Environment Variables → RESEND_API_KEY
RESEND_API_KEY=

# Optional. Defaults to: TBC Advisory <notify@tbcadvisory.com>
# Must be a domain/sender verified in Resend. Reply-To is the visitor.
RESEND_FROM=

# Optional. Hidden /assess gate. Unrelated to the public consult form.
# ASSESS_ACCESS_KEY=
# ASSESS_NOTIFY_EMAIL=info@tbcadvisory.com

# Hidden Buyers Health Check. See BUYERS.md.
# Required in production. If unset outside production, /buyers/admin is open
# and links use a temporary preview signing key that is not a secret.
# BUYERS_ADMIN_KEY=
# BUYERS_LINK_SECRET=
# Soft courtesy cap for agent links. Default 25. Reports past the cap still run.
# BUYERS_AGENT_MONTHLY_CAP=25
# BUYERS_NOTIFY_EMAIL=info@tbcadvisory.com
# Set to blob only after a private Vercel Blob store is connected.
# Also set BLOB_STORE_ID (OIDC) or BLOB_READ_WRITE_TOKEN. Do not use a public store.
# BUYERS_STORAGE=blob

# Optional. Cloudflare Turnstile for /contact and /print.
# Both must be set or the check is skipped and the honeypot still runs.
# Cloudflare dashboard → Turnstile → Add widget (Managed) → site key and secret key.
# https://dash.cloudflare.com/?to=/:account/turnstile
# Redeploy after adding the site key so the browser bundle picks it up.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
